# =========================================================
# TELEGRAM — ОСНОВНОЙ БОТ
# =========================================================

BOT_TOKEN=


# =========================================================
# TELEGRAM — БОТ МОДЕРАТОРОВ
# =========================================================

MODERATOR_BOT_TOKEN=


# =========================================================
# TELEGRAM — КАНАЛ
# =========================================================

CHANNEL_ID=


# =========================================================
# АДМИНИСТРАТОРЫ / ОСНОВАТЕЛИ
# =========================================================

# Telegram ID через запятую
# Пример:
# ADMIN_IDS=123456789,987654321

ADMIN_IDS=


# =========================================================
# GROQ / AI
# =========================================================

GROQ_API_KEY=

# Основная AI-модель
GROQ_MODEL=llama-3.3-70b-versatile

# Резервная AI-модель
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant


# =========================================================
# БАЗА ДАННЫХ
# =========================================================

# Если Railway Volume подключён:
# база автоматически будет размещаться внутри DATA_DIR.

DB_PATH=bot.db

# Дополнительная папка для резервных копий базы
BACKUP_DIR=


# =========================================================
# RAILWAY VOLUME
# =========================================================

# Railway автоматически предоставляет эту переменную,
# если Volume подключён к сервису.
#
# Обычно вручную её задавать НЕ нужно.
#
# Если Railway передаёт её автоматически:
# RAILWAY_VOLUME_MOUNT_PATH=/app/data

RAILWAY_VOLUME_MOUNT_PATH=


# Папка постоянных данных приложения.
#
# Если Volume подключён в /app/data,
# база и резервные копии будут храниться там.

DATA_DIR=/app/data


# =========================================================
# MINI APP
# =========================================================

# Полный URL Mini App панели модератора.
#
# Пример:
# ADMIN_MINIAPP_URL=https://example.up.railway.app/admin

ADMIN_MINIAPP_URL=


# =========================================================
# ВРЕМЯ
# =========================================================

# Все запланированные публикации,
# уведомления, отчёты и другие операции
# работают по московскому времени.

TIMEZONE=Europe/Moscow
